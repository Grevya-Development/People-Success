# ---------------------------------------------------------------------------
# PeopleSuccess by Grevya — environment configuration
# Copy to .env.local for development. In production, set these as secrets.
# ---------------------------------------------------------------------------

# Public URL of the app (used in emails, invitation and offer links).
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Supabase project (local: values from `npx supabase status -o env`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret key (auth admin, signed storage URLs). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Direct Postgres connection. Production: Supabase connection string.
# Using the transaction pooler (port 6543) automatically disables prepared statements.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=10

# 32 random bytes, base64. Encrypts PAN/Aadhaar/passport/bank numbers and integration secrets.
# Generate: openssl rand -base64 32   (rotate only with a re-encryption job)
APP_ENCRYPTION_KEY=

# Email delivery: smtp | resend | log
EMAIL_PROVIDER=log
EMAIL_FROM="PeopleSuccess <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# AI: anthropic | openai | none (features fall back to rule-based results when none)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override. Anthropic default: claude-opus-5-5. Required for OpenAI.
AI_MODEL=
# Optional prices for models not in the built-in table (USD per million tokens).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# Protects /api/cron/tick (serverless scheduler). Generate: openssl rand -hex 24
CRON_SECRET=
